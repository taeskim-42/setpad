# setpad 서명·배포.
#
#   fastlane dev      # 기기 실행용 개발 프로파일 발급 (Xcode 로그인 없이)
#   fastlane beta     # 빌드 → TestFlight
#
# **왜 Xcode 로그인 없이 되는가.** 자동 서명은 Xcode 에 로그인된 계정으로
# 프로파일을 만든다. 여기서는 App Store Connect API 키로 같은 일을 하고,
# 결과를 인증서 저장소에 넣어 다음부터는 받아 쓰기만 한다. 기기를 바꾸거나
# 사람이 늘어도 Xcode 설정을 손으로 맞출 일이 없다.
#
# 필요한 환경변수 (~/.zshrc 에 있다):
#   ASC_KEY_ID  ASC_ISSUER_ID  MATCH_PASSWORD

# **플랫폼마다 다르다.** 스토어가 각자 다른 ID 에 앱을 묶어 놨고, 둘 다 첫
# 등록 뒤로는 못 바꾼다. 번들 ID 는 사용자에게 보이지 않으므로 맞출 이유가
# 없고, 억지로 맞추려다 살아 있는 레코드를 버리는 쪽이 훨씬 비싸다.
#
#   iOS      App Store Connect 앱 'setpad'(id 6757940370)가 이 ID 로 묶여
#            있고 빌드 38 까지 올라가 있다.
#   Android  Play Console 에 이 패키지로 앱을 만들었다.
IOS_APP_ID = "com.tskim.workoutlog"
ANDROID_APP_ID = "com.taeskim.setpad"

default_platform(:ios)

platform :ios do
  # API 키는 모든 레인이 같은 것을 쓴다.
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch(
        "ASC_KEY_PATH",
        "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8",
      ),
    )
  end

  desc "Apple Developer 포털에 App ID 를 등록한다 (한 번만)"
  lane :setup do
    # match 는 App ID 를 만들지 않는다 — 없으면 "Could not find App ID" 로 멈춘다.
    # 여기서는 포털의 번들 ID 만 만든다. App Store Connect 의 앱 레코드(=이름
    # 'setpad' 선점)는 별개의 결정이라 건드리지 않는다.
    produce(
      app_identifier: IOS_APP_ID,
      app_name: "setpad",
      api_key: asc_key,
      skip_itc: true,
    )
  end

  desc "기기 실행용 개발 프로파일"
  lane :dev do
    match(
      type: "development",
      app_identifier: IOS_APP_ID,
      api_key: asc_key,
      # 새 기기가 붙었으면 프로파일을 다시 만든다. 이걸 끄면 기기를 바꿀 때마다
      # "프로파일에 없는 기기" 로 조용히 막힌다.
      force_for_new_devices: true,
    )

    # match 는 **수동 서명**용 프로파일을 만든다. 프로젝트가 자동 서명으로 남아
    # 있으면 Xcode 가 이 프로파일을 무시하고 제 것을 만들려다 계정을 찾는다.
    # Debug 만 바꾼다 — Release 는 beta 레인이 배포 프로파일로 따로 맞춘다.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("FASTLANE_TEAM_ID", "KC564L7GQ8"),
      targets: ["Runner"],
      build_configurations: ["Debug"],
      code_sign_identity: "Apple Development",
      profile_name: "match Development #{IOS_APP_ID}",
    )
  end

  desc "배포용 프로파일만 받아 둔다"
  lane :dist do
    match(type: "appstore", app_identifier: IOS_APP_ID, api_key: asc_key)

    # dev 레인이 Debug 를 수동으로 바꾼 것과 같은 이유다. Release 를 자동인
    # 채로 두면 아카이브할 때 Xcode 가 다시 계정을 찾는다. Release 와
    # Profile 둘 다 바꾼다 — flutter build ipa 는 Release 로 아카이브한다.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("FASTLANE_TEAM_ID", "KC564L7GQ8"),
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{IOS_APP_ID}",
    )
  end

  desc "빌드해서 TestFlight 로"
  lane :beta do
    dist

    # TestFlight 에 올라간 것 다음 수. 사람이 pubspec 을 올리는 것을 잊어도
    # "이미 있는 빌드"로 거절당하지 않는다.
    #
    # 시각(20260905...)을 쓴 적이 있는데 목록에서 37, 38 사이에 끼면 사람이
    # 읽을 수가 없다. iOS 는 Android 와 달리 자릿수 제약이 없으니 연번이 맞다.
    # 그 빌드는 만료시켰지만 값 자체는 남아 있어서, 사람이 쓰는 자릿수만 본다.
    latest = latest_testflight_build_number(
      api_key: asc_key, app_identifier: IOS_APP_ID, initial_build_number: 0,
    )
    latest = 0 if latest > 100_000
    build_number = latest + 1
    sh("cd .. && flutter build ipa --release " \
       "--build-number=#{build_number} --export-method app-store")

    upload_to_testflight(
      api_key: asc_key,
      app_identifier: IOS_APP_ID,
      ipa: "build/ios/ipa/setpad.ipa",
      # 처리 완료를 기다리지 않는다. 몇 분씩 붙잡고 있을 이유가 없다.
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :android do
  desc "빌드해서 Play 내부 테스트로"
  lane :beta do
    # versionCode 는 32비트 정수라 상한이 2,100,000,000 이다. 시각을 그대로
    # 쓰면(예: 2609051747) 넘는다. 2020년부터의 분(分)으로 센다 — 지금
    # 350만쯤이고, 올릴 때마다 반드시 커지며, 한참 뒤에도 상한에 안 닿는다.
    build_number = ((Time.now.to_i - Time.utc(2020, 1, 1).to_i) / 60).to_s
    sh("cd .. && flutter build appbundle --release --build-number=#{build_number}")
    upload_to_play_store(
      package_name: ANDROID_APP_ID,
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      # 등록정보·그래픽은 콘솔에서 사람이 쥔다. 여기서는 바이너리만 올린다.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft",
    )
  end
end
