# setpad 서명·배포.
#
#   fastlane dev      # 기기 실행용 개발 프로파일 발급 (Xcode 로그인 없이)
#   fastlane beta     # 빌드 → TestFlight
#
# **왜 Xcode 로그인 없이 되는가.** 자동 서명은 Xcode 에 로그인된 계정으로
# 프로파일을 만든다. 여기서는 App Store Connect API 키로 같은 일을 하고,
# 결과를 인증서 저장소에 넣어 다음부터는 받아 쓰기만 한다. 기기를 바꾸거나
# 사람이 늘어도 Xcode 설정을 손으로 맞출 일이 없다.
#
# 필요한 환경변수 (~/.zshrc 에 있다):
#   ASC_KEY_ID  ASC_ISSUER_ID  MATCH_PASSWORD

# **플랫폼마다 다르다.** 스토어가 각자 다른 ID 에 앱을 묶어 놨고, 둘 다 첫
# 등록 뒤로는 못 바꾼다. 번들 ID 는 사용자에게 보이지 않으므로 맞출 이유가
# 없고, 억지로 맞추려다 살아 있는 레코드를 버리는 쪽이 훨씬 비싸다.
#
#   iOS      App Store Connect 앱 'setpad'(id 6757940370)가 이 ID 로 묶여
#            있고 빌드 38 까지 올라가 있다.
#   Android  Play Console 에 이 패키지로 앱을 만들었다.
IOS_APP_ID = "com.tskim.workoutlog"
ANDROID_APP_ID = "com.taeskim.setpad"

# pubspec.yaml 의 `version: 1.0.0+44` 에서 앞부분만. **버전은 한 곳에서만
# 읽는다** — App Store 버전 레코드와 빌드의 CFBundleShortVersionString 이
# 어긋나면 빌드가 그 버전에 안 붙는다(1.0 레코드에 1.0.0 빌드가 안 붙어서
# 2026-09-08 에 실제로 막혔다).
def version_name
  line = File.readlines("../pubspec.yaml").find { |l| l.start_with?("version:") }
  UI.user_error!("pubspec.yaml 에서 version 을 못 찾았습니다") unless line
  line.split(":", 2).last.strip.split("+").first
end

default_platform(:ios)

platform :ios do
  # API 키는 모든 레인이 같은 것을 쓴다.
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch(
        "ASC_KEY_PATH",
        "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8",
      ),
    )
  end

  desc "Apple Developer 포털에 App ID 를 등록한다 (한 번만)"
  lane :setup do
    # match 는 App ID 를 만들지 않는다 — 없으면 "Could not find App ID" 로 멈춘다.
    # 여기서는 포털의 번들 ID 만 만든다. App Store Connect 의 앱 레코드(=이름
    # 'setpad' 선점)는 별개의 결정이라 건드리지 않는다.
    produce(
      app_identifier: IOS_APP_ID,
      app_name: "setpad",
      api_key: asc_key,
      skip_itc: true,
    )
  end

  desc "배포 프로파일을 다시 만든다 (기능을 켠 뒤에 한 번)"
  lane :profile do
    # App ID 에 기능을 켜도 이미 만들어진 프로파일에는 안 들어간다. 그대로
    # 빌드하면 "profile doesn't include the ... entitlement" 로 멈춘다.
    match(
      type: "appstore",
      app_identifier: IOS_APP_ID,
      api_key: asc_key,
      force: true,
    )
  end

  desc "기기 실행용 개발 프로파일"
  lane :dev do
    match(
      type: "development",
      app_identifier: IOS_APP_ID,
      api_key: asc_key,
      # 새 기기가 붙었으면 프로파일을 다시 만든다. 이걸 끄면 기기를 바꿀 때마다
      # "프로파일에 없는 기기" 로 조용히 막힌다.
      force_for_new_devices: true,
    )

    # match 는 **수동 서명**용 프로파일을 만든다. 프로젝트가 자동 서명으로 남아
    # 있으면 Xcode 가 이 프로파일을 무시하고 제 것을 만들려다 계정을 찾는다.
    # Debug 만 바꾼다 — Release 는 beta 레인이 배포 프로파일로 따로 맞춘다.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("FASTLANE_TEAM_ID", "KC564L7GQ8"),
      targets: ["Runner"],
      build_configurations: ["Debug"],
      code_sign_identity: "Apple Development",
      profile_name: "match Development #{IOS_APP_ID}",
    )
  end

  desc "배포용 프로파일만 받아 둔다"
  lane :dist do
    match(type: "appstore", app_identifier: IOS_APP_ID, api_key: asc_key)

    # dev 레인이 Debug 를 수동으로 바꾼 것과 같은 이유다. Release 를 자동인
    # 채로 두면 아카이브할 때 Xcode 가 다시 계정을 찾는다. Release 와
    # Profile 둘 다 바꾼다 — flutter build ipa 는 Release 로 아카이브한다.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("FASTLANE_TEAM_ID", "KC564L7GQ8"),
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{IOS_APP_ID}",
    )
  end

  desc "빌드해서 TestFlight 로"
  lane :beta do
    dist

    # TestFlight 에 올라간 것 다음 수. 사람이 pubspec 을 올리는 것을 잊어도
    # "이미 있는 빌드"로 거절당하지 않는다.
    #
    # 시각(20260905...)을 쓴 적이 있는데 목록에서 37, 38 사이에 끼면 사람이
    # 읽을 수가 없다. iOS 는 Android 와 달리 자릿수 제약이 없으니 연번이 맞다.
    # 그 빌드는 만료시켰지만 값 자체는 남아 있어서, 사람이 쓰는 자릿수만 본다.
    latest = latest_testflight_build_number(
      api_key: asc_key, app_identifier: IOS_APP_ID, initial_build_number: 0,
    )
    latest = 0 if latest > 100_000
    build_number = latest + 1
    # 서버 주소를 환경변수로 갈아끼울 수 있게 둔다. gym.darak.studio 인증서가
    # 안 나오는 동안 Railway 주소로 빌드해서 테스트를 시작해야 했다.
    api_base = ENV["API_BASE"]
    sh("cd .. && flutter build ipa --release " \
       "#{api_base ? "--dart-define=API_BASE=#{api_base} " : ""}" \
       "--build-number=#{build_number} --export-method app-store")

    upload_to_testflight(
      api_key: asc_key,
      app_identifier: IOS_APP_ID,
      ipa: "build/ios/ipa/setpad.ipa",
      # 처리 완료를 기다리지 않는다. 몇 분씩 붙잡고 있을 이유가 없다.
      skip_waiting_for_build_processing: true,
    )
  end

  desc "등록 정보와 스크린샷을 올린다 (빌드는 안 만든다)"
  lane :metadata do
    # **여덟 언어를 한꺼번에 올린다.** 손으로 넣으면 반드시 몇 개가 빠지고,
    # 빠진 언어는 App Store 에서 영어로 떨어진다 — 앱은 그 말로 뜨는데
    # 소개만 영어인 상태가 된다.
    #
    # 스크린샷도 여기서 같이 간다. 문구와 그림이 따로 올라가면 심사에
    # 어느 쪽이 최신인지 사람이 대조해야 한다.
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: IOS_APP_ID,
      app_version: version_name,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      # 그림은 `screenshots` 레인이 따로 올린다 — 한 번에 하면 실패했을 때
      # 문구가 올라갔는지 그림이 올라갔는지 로그에서 갈라내기 어렵다.
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "스크린샷만 올린다"
  lane :screenshots do
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: IOS_APP_ID,
      app_version: version_name,
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "TestFlight 에 올라간 빌드를 심사에 제출 (승인 시 자동 출시)"
  lane :submit do
    version = version_name
    # App Store Connect 가 **실제로 받은** 번호를 쓴다. pubspec 만 고치고
    # 빌드를 안 올렸으면 여기서 어긋난 채 제출되어 옛 빌드가 심사에 들어간다.
    build = latest_testflight_build_number(
      api_key: asc_key, app_identifier: IOS_APP_ID, version: version,
    )
    UI.message("제출: #{version} (#{build})")

    deliver(
      api_key: asc_key,
      app_identifier: IOS_APP_ID,
      app_version: version,
      build_number: build.to_s,
      # 바이너리·등록정보는 앞 레인들이 이미 올렸다. 여기서는 제출만.
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        # Info.plist 의 ITSAppUsesNonExemptEncryption=false 와 같은 값이어야
        # 한다 — 다르면 심사에서 되돌아온다.
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
  end

  desc "원커맨드 출시 — 등록정보·스크린샷 올리고 심사 제출"
  lane :release do
    metadata
    screenshots
    submit
  end
end


platform :android do
  desc "빌드해서 Play 내부 테스트로"
  lane :beta do
    # versionCode 는 32비트 정수라 상한이 2,100,000,000 이다. 시각을 그대로
    # 쓰면(예: 2609051747) 넘는다. 2020년부터의 분(分)으로 센다 — 지금
    # 350만쯤이고, 올릴 때마다 반드시 커지며, 한참 뒤에도 상한에 안 닿는다.
    build_number = ((Time.now.to_i - Time.utc(2020, 1, 1).to_i) / 60).to_s
    api_base = ENV["API_BASE"]
    sh("cd .. && flutter build appbundle --release " \
       "#{api_base ? "--dart-define=API_BASE=#{api_base} " : ""}" \
       "--build-number=#{build_number}")
    upload_to_play_store(
      package_name: ANDROID_APP_ID,
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      # 등록정보·그래픽은 콘솔에서 사람이 쥔다. 여기서는 바이너리만 올린다.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft",
    )
  end

  desc "스토어 등록정보(제목·설명)만 올린다. AAB·이미지는 안 건드린다"
  lane :metadata do
    upload_to_play_store(
      package_name: ANDROID_APP_ID,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      metadata_path: "fastlane/metadata/android",
      track: "internal",
      version_code: google_play_track_version_codes(
        package_name: ANDROID_APP_ID, track: "internal",
      ).first,
    )
  end

  desc "스크린샷·그래픽만 올린다. 문구·AAB 는 안 건드린다"
  lane :images do
    # 문구와 갈라 두는 이유: 그림을 안 고친 날에도 수십 장을 매번 덮어쓰면
    # 느리고, 무엇이 언제 바뀌었는지 흐려진다.
    upload_to_play_store(
      package_name: ANDROID_APP_ID,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: true,
      metadata_path: "fastlane/metadata/android",
      track: "internal",
      version_code: google_play_track_version_codes(
        package_name: ANDROID_APP_ID, track: "internal",
      ).first,
    )
  end

  desc "프로덕션 트랙에 올린다 — 구글 심사 통과 시 자동 출시"
  lane :production do
    build_number = ((Time.now.to_i - Time.utc(2020, 1, 1).to_i) / 60).to_s
    sh("cd .. && flutter build appbundle --release " \
       "--build-name=#{version_name} --build-number=#{build_number}")
    upload_to_play_store(
      package_name: ANDROID_APP_ID,
      track: "production",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      # **초안 앱에는 초안 릴리스만 만들 수 있다.** Google 이 그렇게 답한다:
      # "Only releases with status draft may be created on draft app."
      # 첫 출시는 콘솔에서 데이터 보안·콘텐츠 등급·타겟층을 채우고 사람이
      # 한 번 눌러야 앱이 초안을 벗는다. 그다음부터 completed 로 바꿔도 된다.
      release_status: "draft",
    )
  end

  desc "트랙별 현재 버전코드"
  lane :status do
    %w[internal alpha beta production].each do |track|
      codes = google_play_track_version_codes(package_name: ANDROID_APP_ID, track: track)
      UI.message("#{track}: #{codes.empty? ? '없음' : codes.join(', ')}")
    rescue StandardError => e
      UI.important("#{track}: 조회 실패 (#{e.message.lines.first.to_s.strip})")
    end
  end
end
