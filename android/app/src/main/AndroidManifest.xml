<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Health Connect. 이 넷은 lib/health.dart 의 _access 와 하나씩 짝이다 —
         WORKOUT 쓰기, 활동 칼로리 읽기, 심박 읽기, 기초대사량 읽기(그날 쓴 칼로리,
         2026-09-26). 더 넣지 않는다.
         심박은 타바타 휴식을 끊는 데 쓴다(lib/rest_recovery.dart). Play 가 한 번
         "기능에 필요 없어 보인다" 며 반려했다(2026-09-23) — 기능이 타이머 줄에만
         보였다. 그래서 까닭을 설정·권한 설명 화면(lib/health_page.dart)과 스토어
         설명에 적었다. 권한을 바꾸면 그 셋과 Play Console 선언을 같이 고친다. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE"/>
    <!-- 체중은 "건강 앱에서 가져오기" 를 눌렀을 때만 따로 묻는다(HealthLink.authorizeWeight). -->
    <!-- 트레이너 보고 알림(lib/agent_alarm.dart). 재부팅하면 걸어 둔 알림이
         지워지므로 플러그인이 다시 건다. 정확한 알람 권한(SCHEDULE_EXACT_ALARM,
         USE_EXACT_ALARM)은 넣지 않는다 — Play 가 권한 사유로 거절한 전력이 있고,
         몇 분 늦는 알림으로 충분하다. POST_NOTIFICATIONS 는 플러그인이 합쳐 준다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Workout recording foreground service (TimingService): while a workout
         timer run or a set rest runs, the app keeps counting, cueing and
         recording the workout with the screen off or the app in the background.
         Type "health": Google's FGS types page describes it as "Any long-running
         use cases to support apps in the fitness category such as exercise
         trackers", and the Play FAQ says "an exercise app that tracks a user's
         exercise can declare the "health" foreground service type". Not
         mediaPlayback ("Continue audio or video playback from the background"):
         the service also runs through long silent stretches (rest, a Tabata
         without a beat), and Play says "Don't declare invalid or inaccurate FGS
         types". Play Console declaration: docs/android-fgs-play-declaration.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <!-- The health type's runtime prerequisite on Android 14+: "At least one of
         the following conditions must be true: Declare the
         HIGH_SAMPLING_RATE_SENSORS permission in your manifest. Request and be
         granted at least one of ... READ_HEART_RATE ...". READ_HEART_RATE
         (above) is granted only by users who allow heart rate, so a user who
         refuses it would lose the service (startForeground throws). This normal
         permission (no prompt) is the condition that holds for every user. The
         app reads no motion sensors itself. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>
    <!-- Held only while a timer runs AND the app is not visible (TimingService). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 백업에서 로그인 표를 뺀다(res/xml). 기록은 그대로 백업된다. -->
    <application
        android:label="setpad"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 헬스장 스티커. autoVerify 가 있어야 브라우저를 거치지 않고
                 앱이 바로 열린다 — 서버의 assetlinks.json 과 짝이다.
                 /c/ 아래는 앱이 여는 셋만 받는다: 스티커 /c/<도장 id>, 단톡방의 수업·PT 예약
                 /c/<id>/classes·/c/<id>/bookings. 그 밖의 하위 화면(식단 등)은 앱에 없어
                 웹에서 열린다(서버 apple-app-site-association 의 '/c/*/*' exclude 와 짝).
                 '.' 은 아무 글자 하나다. minSdk 26 이 아는 단순 glob 에는 '/ 가 아닌 글자' 가
                 없어 도장 id(uuid 8-4-4-4-12)를 길이로 맞춘다 — 그것을 쓰는
                 pathAdvancedPattern 은 API 31 부터라 그 아래 기기는 건너뛴다.
                 한 intent-filter 의 data 는 서로 섞인다: 두 host 모두 아래 경로를 다 받는다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="gym.darak.studio"
                      android:pathPattern="/c/........-....-....-....-............"/>
                <data android:scheme="https"
                      android:host="gym.darak.studio"
                      android:pathPattern="/c/........-....-....-....-............/classes"/>
                <data android:scheme="https"
                      android:host="gym.darak.studio"
                      android:pathPattern="/c/........-....-....-....-............/bookings"/>
                <!-- 대신 적어 준 운동 기록을 건네받는 링크. -->
                <data android:scheme="https"
                      android:host="gym.darak.studio"
                      android:pathPrefix="/r/"/>
                <!-- 같이 하기 초대 링크. 앱이 그 토큰으로 참여한다(서버 AASA '/j/*' 와 짝). -->
                <data android:scheme="https"
                      android:host="gym.darak.studio"
                      android:pathPrefix="/j/"/>
                <!-- 이미 나간 스티커가 옛 주소를 가리킬 수 있다. -->
                <data android:scheme="https"
                      android:host="web-production-9cfc2.up.railway.app"/>
            </intent-filter>
            <!-- 웹에서 앱으로 되돌아오는 길. https 링크가 브라우저로 떨어졌을
                 때 그 화면에서 앱을 여는 수단이다. 웹 로그인(카카오)의 표도 이 길로
                 돌아온다(setpad://signin). 검증되지 않은 스킴이라 같은 스킴을 선언한
                 다른 앱도 받을 수 있다 — 남은 위험과 미룬 까닭은 lib/sign_in.dart
                 signInViaWeb 에 적었다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="setpad"/>
            </intent-filter>
            <!-- Health Connect 가 "왜 이 권한이 필요한가"를 물을 때 여는 화면 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Health Connect 권한 화면이 개인정보 처리방침으로 되돌아오는 길.
             없으면 민감 권한 요청이 Google 심사에서 막힌다. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <service
            android:name=".TimingService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="health"/>
        <!-- 걸어 둔 알림을 띄우고, 재부팅·앱 업데이트 뒤 다시 거는 플러그인 리시버. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Health Connect 가 깔려 있는지 본다. Android 11 부터는 조회 대상에
             적어 두지 않으면 설치돼 있어도 없는 것으로 보인다. -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
    </queries>
</manifest>
